---
import styles from './statisticsCardComponent.module.scss'
import CardWrapper from '@/components/layout/cardWrapper/CardWrapper.astro'

interface Props {
  value: string
  label: string
}

const { value, label } = Astro.props as Props
---

<CardWrapper size="small" class={styles.card}>
  <p>{value}</p>
  <h4>{label}</h4>
</CardWrapper>
