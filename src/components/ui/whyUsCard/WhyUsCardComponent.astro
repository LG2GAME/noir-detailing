---
import CardWrapper from '@/components/layout/cardWrapper/CardWrapper.astro'

interface Props {
  title: string
  description: string
  link: string
}

const { title, description, link }: Props = Astro.props
---

<CardWrapper>
  <img src="@/assets/icons/cube.svg" alt="icon" />
  <h4>{title}</h4>
  <p>{description}</p>
  <a href={link} target="_blank" rel="noopener noreferrer"> Learn More </a>
</CardWrapper>
