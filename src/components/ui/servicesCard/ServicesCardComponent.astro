---
import styles from './servicesCardComponent.module.scss'
import CardWrapper from '@/components/layout/cardWrapper/CardWrapper.astro'

interface Props {
  image: { src: string; alt: string }
  header: string
  list: string[]
  link: string
}

const { image, header, list, link } = Astro.props as Props
---

<CardWrapper size="none" class={styles.card}>
  <img src={image.src} alt={image.alt} />
  <div class={styles.content}>
    <h4>{header}</h4>
    <ul>
      {list.map((item) => <li>{item}</li>)}
    </ul>
    <a href={link}>Learn More</a>
  </div>
</CardWrapper>
