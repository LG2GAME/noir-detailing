---
import CardWrapper from '@/components/layout/cardWrapper/CardWrapper.astro'
import styles from './processCard.module.scss'

interface Props {
  id: number
  title: string
  description: string
}

const { id, title, description }: Props = Astro.props
---

<CardWrapper size="normal" class={styles.card}>
  <p class={styles.id}>0{id}</p>
  <h4>{title}</h4>
  <p>{description}</p>
</CardWrapper>
