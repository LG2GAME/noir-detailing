---
import ContentWrapper from '@/components/layout/wrapper/ContentWrapper.astro'
import HeadingComponent from '@/components/ui/heading/HeadingComponent.astro'
import styles from './advantagesSection.module.scss'
import WhyUsCardComponent from '@/components/ui/whyUsCard/WhyUsCardComponent.astro'
import { advantages } from '@/assets/data/advantages.ts'
---

<section class={styles.advantages}>
  <ContentWrapper class={styles.advantagesContent}>
    <HeadingComponent type="default" tagline="Why noir"
      >The Difference Is In The Detail</HeadingComponent
    >
    <div class={styles.advantagesGrid}>
      {
        advantages.map((whyNoir) => (
          <WhyUsCardComponent
            icon={whyNoir.icon}
            title={whyNoir.title}
            description={whyNoir.description}
            link={whyNoir.link}
          />
        ))
      }
    </div>
  </ContentWrapper>
</section>
